{
  "name": "schiffi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schiffi - 2D online trading, exploration and seafaring strategy game",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "migrate": "node server/src/db/migrate.mjs",
    "test": "node --experimental-sqlite --test server/test/shared.test.mjs server/test/gameplay.test.mjs server/test/e2e.test.mjs",
    "test:browser": "npm run build --workspace=client && node --experimental-sqlite --test client/test/browser.test.mjs",
    "test:all": "npm run test && npm run test:browser"
  }
}
