# ---------------------------------------------------------------------------
# Schiffi environment configuration.  Copy to .env and fill in.
# NEVER commit .env.  NEVER put a Cloudflare *Global* API key anywhere:
# use a scoped API token with the minimum required permissions instead.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8080

# --- Database -------------------------------------------------------------
# Primary target is PostgreSQL. If DATABASE_URL is empty the server falls back
# to the bundled SQLite file driver (node:sqlite) so it runs with zero setup.
DATABASE_URL=
# DATABASE_URL=postgres://schiffi:schiffi@localhost:5432/schiffi
SQLITE_PATH=./data/schiffi.db

# --- Security -------------------------------------------------------------
# 64 hex chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Opens the password vault, which stores a recoverable copy of each password
# so the superadmin console can display it. 64 hex chars, same generator as
# above. Leave EMPTY to keep passwords unreadable (Argon2id hash only).
# With a key set: anyone holding this key and a database dump holds every
# password stored after the key was configured.
PASSWORD_VAULT_KEY=

# Argon2id tuning (memory in KiB)
ARGON2_MEMORY=19456
ARGON2_TIME=2
ARGON2_PARALLELISM=1

# --- Mail -----------------------------------------------------------------
# When SMTP_HOST is empty, mail is written to ./data/mail/*.eml (real files,
# real MIME) instead of being sent - so nothing is faked, it is just spooled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Schiffi <no-reply@example.org>"

# --- Game -----------------------------------------------------------------
WORLD_TICK_HZ=20
NET_SNAPSHOT_HZ=10
DEFAULT_WORLD_SEED=
OWNER_EMAIL=
OWNER_BOOTSTRAP_TOKEN=
